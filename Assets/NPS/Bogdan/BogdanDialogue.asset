  m_Script: {fileID: 11500000, guid: 2f44d7f534712104186f3dbf6106b7d3, type: 3}
  m_Name: BogdanDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: "\u0414\u0430\u043B\u0438\u0431\u0430 \u0411\u043E\u0433\u0434\u0430\u043D"
  npcPortrait: {fileID: 7712031267872403820, guid: 366d96d44b5a4924ba2fbc0fb3983a34, type: 3}
  dialoguelines:
  - "\u041F\u0440\u0438\u0432\u0435\u0442! \u0422\u044B \u043D\u0430\u0441\u0447\u0451\u0442
    \u0421\u0442\u0430\u0441\u0430? \u041E\u043D \u0431\u044B\u043B \u0437\u0434\u0435\u0441\u044C
    \u043D\u0435\u0434\u0430\u0432\u043D\u043E, \u0430 \u043F\u043E\u0442\u043E\u043C
    \u043F\u043E\u0448\u0451\u043B \u0432 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u044B\u0439
    \u043A\u043B\u0443\u044E \u0420\u0418\u041D\u0425\u0410 \u043D\u0430 \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u0435. "
  - "\u0412\u0437\u0430\u043C\u0435\u043D, \u043F\u0440\u043E\u0448\u0443 \u0442\u0435\u0431\u044F
    \u043F\u043E\u043C\u043E\u0447\u044C \u0441 \u043A\u043E\u0434\u043E\u043C \u043D\u0430\u0448\u0435\u0433\u043E
    \u043F\u0440\u043E\u0435\u043A\u0442\u0430 \u043D\u0430 \u0432\u0441\u0435\u0440\u043E\u0441\u0441\u0438\u0439\u0441\u043A\u043E\u043C
    \u0445\u0430\u043A\u0430\u0442\u043E\u043D\u0435. \u041F\u043E\u043C\u043E\u0433\u0438
    \u0440\u0435\u0448\u0438\u0442\u044C \u0437\u0430\u0434\u0430\u0447\u0438. \u041E\u043D\u0438
    \u0443\u0436\u0435 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u044B \u043D\u0430
    \u043F\u043A \u043F\u0440\u044F\u043C\u043E \u0437\u0430 \u043C\u043D\u043E\u0439"
  - "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u041F\u043E\u0434\u043E\u0439\u0434\u0438
    \u043A \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0443 \u043F\u0440\u044F\u043C\u043E
    \u0437\u0430 \u043C\u043D\u043E\u0439"
  - "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E \u0442\u0435\u0431\u044F!"
