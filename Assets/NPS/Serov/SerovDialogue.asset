  m_Name: SerovDialogue
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: "\u0421\u0435\u0440\u043E\u0432 \u0410\u043B\u0435\u043A\u0441\u0435\u0439
    \u041E\u043B\u0435\u0433\u043E\u0432\u0438\u0447"
  npcPortrait: {fileID: -1713528914611444333, guid: 7525167f57a1186488b9b67a0a634f94, type: 3}
  dialoguelines:
  - "\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439, \u0441\u043F\u0430\u0441\u0438\u0431\u043E
    \u0447\u0442\u043E \u043F\u0440\u0438\u0448\u0451\u043B"
  - "\u0423 \u0432\u0430\u0441 \u0432 \u0433\u0440\u0443\u043F\u043F\u0435 \u0435\u0441\u0442\u044C
    \u0441\u0442\u0443\u0434\u0435\u043D\u0442 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043D\u0438 \u0440\u0430\u0437\u0443 \u043D\u0435 \u043F\u043E\u0441\u0435\u0449\u0430\u043B
    \u043B\u0435\u043A\u0446\u0438\u0438. \u042F \u043D\u0435 \u0437\u043D\u0430\u044E
    \u0447\u0442\u043E \u0441 \u043D\u0438\u043C \u0434\u0435\u043B\u0430\u0442\u044C.
    \u041C\u043E\u0436\u0435\u0448\u044C \u0443\u0437\u043D\u0430\u0442\u044C \u0432
    \u0434\u0435\u043A\u0430\u043D\u0430\u0442\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
    \u043E \u043D\u0451\u043C?"
  - "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u044F \u0437\u043D\u0430\u043B
    \u0447\u0442\u043E \u0442\u044B \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u044B\u0439
    \u0441\u0442\u0443\u0434\u0435\u043D\u0442."
  - "\u0414\u0435\u043A\u0430\u043D\u0430\u0442 \u043F\u0440\u044F\u043C\u043E \u0437\u0430
    \u044D\u0442\u043E\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0435\u0439.
    \u0422\u0430\u043C \u0434\u043E\u043B\u0436\u043D\u0430 \u0437\u043D\u0430\u0442\u044C,
    \u0447\u0442\u043E  \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0441
    \u044D\u0442\u0438\u043C \u0441\u0442\u0443\u0434\u0435\u043D\u0442\u043E\u043C"
  - "\u0416\u0430\u043B\u044C. \u041D\u0430\u0434\u0435\u044E\u0441\u044C \u0442\u044B
    \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u0430\u0435\u0448\u044C."
  - "\u042F \u0431\u0443\u0434\u0443 \u0436\u0434\u0430\u0442\u044C \u0442\u0435\u0431\u044F
    \u0437\u0434\u0435\u0441\u044C \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u043F\u0430\u0440\u044B."
  - "\u0414\u0435\u043A\u0430\u043D\u0430\u0442 \u043F\u0440\u044F\u043C\u043E \u0437\u0430
    \u044D\u0442\u043E\u0439 \u0430\u0443\u0434\u0438\u0442\u043E\u0440\u0438\u0435\u0439."
  - "\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
  - "\u0422\u0435\u043F\u0435\u0440\u044C \u044F \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u044E
    \u0437\u0430\u0447\u0451\u0442"
  autoProgressLines: 010000000000000100
