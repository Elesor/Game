  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ed76ac77733b194f85efd29346d1972, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CodingMiniGame
  codePanel: {fileID: 1201290809}
  codeInput: {fileID: 1152192899}
  taskText: {fileID: 1065478337}
  resultText: {fileID: 1959074630}
  submitButton: {fileID: 2088247364}
  closeButton: {fileID: 878705171}
  tasks:
  - description: "\u0417\u0430\u0434\u0430\u0447\u0430 1: \u041D\u0430\u043F\u0438\u0448\u0438\u0442\u0435
      \u0443\u0441\u043B\u043E\u0432\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442, \u0447\u0442\u043E
      \u0447\u0438\u0441\u043B\u043E x \u0431\u043E\u043B\u044C\u0448\u0435 5."
    expectedOutput: true
    requiredKeywords:
    - if
    - return
    - '>'
    forbiddenKeywords:
    - else
    - while
    - for
    testInput: x=10
  - description: "\u0417\u0430\u0434\u0430\u0447\u0430 2 (\u041B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0418):\\n\u041D\u0430\u043F\u0438\u0448\u0438\u0442\u0435 \u043A\u043E\u0434,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      true, \u0435\u0441\u043B\u0438 x > 0 \u0418 y < 10.\\n\\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 && (\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0418)"
    expectedOutput: true
    requiredKeywords:
    - return
    - '&&'
    forbiddenKeywords:
    - if
    - else
    testInput: x=5,y=5
  - description: "\u0417\u0430\u0434\u0430\u0447\u0430 3 (\u041B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0418\u041B\u0418):\\n\u041D\u0430\u043F\u0438\u0448\u0438\u0442\u0435 \u043A\u043E\u0434,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      true, \u0435\u0441\u043B\u0438 isActive = true \u0418\u041B\u0418 count > 0.\\n\\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440 || (\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0418\u041B\u0418)"
    expectedOutput: true
    requiredKeywords:
    - return
    - '||'
    forbiddenKeywords:
    - if
    testInput: isActive=false,count=10
